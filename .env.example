# Data source for the customer app. "mock" uses the in-browser mock backend.
# Set to "supabase" once the Supabase adapters in src/services/adapters are implemented.
VITE_DATA_SOURCE=mock

# Public (anon) Supabase credentials only. NEVER put a service-role key in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
